# Copy this file to .env and fill in values before running the app.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg DSNs read by app/core/config.py. Both are required.
DATABASE_URL_PROD=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/squiidwiki_db
DATABASE_URL_TEST=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/squiidwiki_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGEME_USE_SECRETS_TOKEN_HEX_32

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Cloudflare R2 (media storage) ─────────────────────────────────────────────
# Leave empty to run without uploads; the upload endpoint then returns 500.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PROD=
R2_BUCKET_TEST=
R2_SIGNED_URL_TTL_SECONDS=86400

# ── MDOC OTIS ─────────────────────────────────────────────────────────────────
# mdocweb.state.mi.us sits behind Cloudflare, which returns a 403 to this
# server's IP on every path. Point this at a SOCKS5 proxy that egresses
# somewhere unblocked; `infra/otis-tunnel.sh`, run on your own machine, opens
# one over a reverse SSH forward. Leave empty and /api/v1/mdoc/lookup returns
# 502; /api/v1/mdoc/parse, which takes HTML you supply, still works.
MDOC_PROXY=

# ── docker-compose only ───────────────────────────────────────────────────────
# Consumed by docker-compose.yml, not by the backend. Required when you run
# `docker compose up` (compose fails fast if the passwords are unset).
POSTGRES_USER=postgres
POSTGRES_DB=squiidwiki_db
POSTGRES_PASSWORD=CHANGEME
GRAFANA_ADMIN_PASSWORD=CHANGEME
