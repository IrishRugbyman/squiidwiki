# Copy to .env and fill in values.
# Nested settings use __ as delimiter (e.g. DATABASE__HOST overrides settings.database.host).

APP_ENV=development

# Full database URL (overrides all DATABASE__ vars when set)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/squiidwiki_db

# Individual database settings (used when DATABASE_URL is not set)
# DATABASE__USER=postgres
# DATABASE__PASSWORD=postgres
# DATABASE__HOST=localhost
# DATABASE__PORT=5432
# DATABASE__DATABASE=squiidwiki_db

# Auth
AUTH__ENABLED=true
AUTH__JWT_SECRET_KEY=change-me-in-production
# AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=1440
# AUTH__DEFAULT_ADMIN_USERNAME=admin
# AUTH__DEFAULT_ADMIN_PASSWORD=change-me-in-production

# Server
# SERVER__PORT=8002
# SERVER__HOST=0.0.0.0
